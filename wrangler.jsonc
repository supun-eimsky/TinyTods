{
	"name": "tinytods",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "tinytods-images"
		},
		{
			"bucket_name": "tinytods-images",
			"binding": "tinytods_images",
			"remote": true
		},
        {
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "tinytods-isr-cache"
		}
	],
    "durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
    "migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DOQueueHandler"]
		}
	],
    "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "tinytods-tag-cache",
      "database_id": "17df09e3-8e59-478e-b1a6-8dffcea5c38e"
    }
  ],
	"hyperdrive": [
		{
			"binding": "HYPERDRIVE",
			"id": "e0b253d05d2d4671b40607eb6e634c80",
			"localConnectionString": "mysql://admin:htSZR7PmXKeBj4cujkaE@database-1.c900wacouy45.eu-north-1.rds.amazonaws.com:3306/tinytods"
		}
	]
}